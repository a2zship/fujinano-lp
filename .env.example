# ==== Fujinano Landing — biến môi trường (mục 5) ====
# Copy sang .env.local và điền giá trị thật. KHÔNG commit .env.local.

# URL công khai của site (dùng cho canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3151

# Liên hệ — [CẦN XÁC NHẬN] số hotline/Zalo chính thức của Fujinano
NEXT_PUBLIC_HOTLINE=
NEXT_PUBLIC_ZALO_URL=

# Tracking (để trống nếu chưa dùng — script sẽ không nạp)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# CRM/Lead đích đến (server). Trống -> lưu ./data/leads.jsonl (chỉ dev)
LEAD_WEBHOOK_URL=
